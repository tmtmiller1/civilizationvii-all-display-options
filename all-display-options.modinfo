<?xml version="1.0" encoding="utf-8"?>
<Mod id="all-display-options" version="2" xmlns="ModInfo">
    <Properties>
        <Name>LOC_MOD_ALL_DISPLAY_OPTIONS_NAME</Name>
        <Description>LOC_MOD_ALL_DISPLAY_OPTIONS_DESCRIPTION</Description>
        <Authors>Tower</Authors>
        <Package>AllDisplayOptionsMod</Package>
        <PackageSortIndex>1000</PackageSortIndex>
        <Version>1.0.3</Version>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet></AlwaysMet>
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <!-- Shell scope: the Options screen on the main menu. -->
        <ActionGroup id="all-display-options-shell" scope="shell" criteria="always">
            <Properties>
                <LoadOrder>60</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/ModText.xml</Item>
                    <Item locale="de_DE">text/de_de/ModText.xml</Item>
                    <Item locale="es_ES">text/es_es/ModText.xml</Item>
                    <Item locale="fr_FR">text/fr_fr/ModText.xml</Item>
                    <Item locale="it_IT">text/it_it/ModText.xml</Item>
                    <Item locale="ja_JP">text/ja_jp/ModText.xml</Item>
                    <Item locale="ko_KR">text/ko_kr/ModText.xml</Item>
                    <Item locale="pl_PL">text/pl_pl/ModText.xml</Item>
                    <Item locale="pt_BR">text/pt_br/ModText.xml</Item>
                    <Item locale="ru_RU">text/ru_ru/ModText.xml</Item>
                    <Item locale="zh_Hans_CN">text/zh_cn/ModText.xml</Item>
                    <Item locale="zh_Hant_HK">text/zh_hk/ModText.xml</Item>
                </UpdateText>
                <UIScripts>
                    <!-- Tower Settings Keeper: listed first, imports nothing, so it runs before anything reads storage. -->
                    <Item>ui/settings-keeper.js</Item>
                    <Item>ui/all-display-options-mod-options.js</Item>
                    <Item>ui/all-display-options.js</Item>
                </UIScripts>
                <ImportFiles>
                    <Item>ui/all-display-options-mod-options.js</Item>
                    <Item>ui/all-display-options-core.js</Item>
                    <Item>ui/all-display-options.js</Item>
                </ImportFiles>
            </Actions>
        </ActionGroup>
        <!-- Game scope: the in-game pause-menu Options screen. -->
        <ActionGroup id="all-display-options-game" scope="game" criteria="always">
            <Properties>
                <LoadOrder>60</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/ModText.xml</Item>
                    <Item locale="de_DE">text/de_de/ModText.xml</Item>
                    <Item locale="es_ES">text/es_es/ModText.xml</Item>
                    <Item locale="fr_FR">text/fr_fr/ModText.xml</Item>
                    <Item locale="it_IT">text/it_it/ModText.xml</Item>
                    <Item locale="ja_JP">text/ja_jp/ModText.xml</Item>
                    <Item locale="ko_KR">text/ko_kr/ModText.xml</Item>
                    <Item locale="pl_PL">text/pl_pl/ModText.xml</Item>
                    <Item locale="pt_BR">text/pt_br/ModText.xml</Item>
                    <Item locale="ru_RU">text/ru_ru/ModText.xml</Item>
                    <Item locale="zh_Hans_CN">text/zh_cn/ModText.xml</Item>
                    <Item locale="zh_Hant_HK">text/zh_hk/ModText.xml</Item>
                </UpdateText>
                <UIScripts>
                    <!-- Tower Settings Keeper: listed first, imports nothing, so it runs before anything reads storage. -->
                    <Item>ui/settings-keeper.js</Item>
                    <Item>ui/all-display-options-mod-options.js</Item>
                    <Item>ui/all-display-options.js</Item>
                </UIScripts>
                <ImportFiles>
                    <Item>ui/all-display-options-mod-options.js</Item>
                    <Item>ui/all-display-options-core.js</Item>
                    <Item>ui/all-display-options.js</Item>
                </ImportFiles>
            </Actions>
        </ActionGroup>
    </ActionGroups>
    <LocalizedText>
        <File>text/en_us/ModText.xml</File>
    </LocalizedText>
</Mod>
